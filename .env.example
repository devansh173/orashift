# Copy to .env and fill in. .env is git-ignored and must never be committed.

# --- Oracle: the translation SOURCE dialect --------------------------------
# Oracle AI Database 26ai Free (23.26.2.0.0), pluggable database FREEPDB1.
ORACLE_HOST=localhost
ORACLE_PORT=1521
ORACLE_SERVICE=FREEPDB1
ORACLE_USER=orashift
ORACLE_PASSWORD=change-me

# --- PostgreSQL: the translation TARGET dialect ----------------------------
PG_HOST=localhost
PG_PORT=5432
PG_DATABASE=orashift
PG_USER=orashift
PG_PASSWORD=change-me

# --- Used only by docker-compose.yml ---------------------------------------
# Ignore these if you point the variables above at databases you already run.
ORACLE_SYS_PASSWORD=change-me
PG_SUPERUSER_PASSWORD=change-me

# --- Optional: LLM generation of extra source units (phase 2) --------------
# Off by default. The templates already cover every construct; this only adds
# variety, and it costs money. Works with any OpenAI-compatible endpoint
# (OpenAI, Groq, Together, OpenRouter, or a local Ollama / vLLM server).
UNIT_LLM_ENABLED=false
UNIT_LLM_BASE_URL=https://api.openai.com/v1
UNIT_LLM_API_KEY=
UNIT_LLM_MODEL=gpt-4o-mini
UNIT_LLM_PER_CATEGORY=5

# --- Behaviour -------------------------------------------------------------
CONNECT_TIMEOUT_SECONDS=10
LOG_LEVEL=INFO
# console (human readable) or json (one object per line)
LOG_FORMAT=console
